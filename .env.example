# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every setting is prefixed ASKOZ_ so it can't clash with other tools' env vars.

ASKOZ_ENV=dev
ASKOZ_LOG_LEVEL=INFO

# Local services from docker-compose.yml
ASKOZ_DATABASE_URL=postgresql://askoz:askoz@127.0.0.1:5432/askoz
ASKOZ_REDIS_URL=redis://127.0.0.1:6379/0

# Crawler identity shown to government sites. The URL (required for `askoz crawl`)
# should explain the bot; the repo README works. The email is optional.
ASKOZ_CRAWL_CONTACT_URL=
ASKOZ_CRAWL_CONTACT_EMAIL=

# Needed from later phases: uncomment when we get there
# ASKOZ_VOYAGE_API_KEY=
# ASKOZ_ANTHROPIC_API_KEY=
